# Porta del server backend
PORT=3001

# URL del frontend autorizzato (CORS). In produzione metti l'URL Netlify/Vercel.
FRONTEND_URL=http://localhost:5173

# Provider dati di mercato predefinito: "coingecko" oppure "binance"
MARKET_PROVIDER=coingecko

# Supabase - usate per verificare il token utente e salvare la watchlist.
# La SERVICE_ROLE_KEY e' segreta: NON metterla mai nel frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
